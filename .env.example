# Equipos a revisar: Nombre=host  (ping)  o  Nombre=host:puerto  (TCP), separados por comas
EQUIPOS=DNS Google=8.8.8.8,DNS Cloudflare=1.1.1.1,Google HTTPS=google.com:443

# WiFi: detecta solo la red y el router; avisa si te desconectas, cambias de red o baja la señal
MONITOREAR_WIFI=1
SENAL_MINIMA=40
HISTORIAL_WIFI=wifi_historial.csv
# Cada caída con su diagnóstico (qué pasó y por qué pudo ser)
INCIDENTES_ARCHIVO=incidentes.csv

INTERVALO_SEGUNDOS=5
TIMEOUT_SEGUNDOS=2
FALLOS_PARA_CAIDA=3
LOG_ARCHIVO=monitor.log

# Opcional: avisos por Telegram (déjalos vacíos para desactivar)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
